# VS Code Extension Ignore File
# Files and directories to exclude from the extension package

# Source files (only compiled output is needed)
src/**
tsconfig.json

# Development files
.vscode/**
.vscode-test/**
.gitignore
.eslintrc.json
.prettierrc
.editorconfig

# Build artifacts
**/*.map
**/*.ts
!**/*.d.ts

# Node modules (dependencies are bundled)
node_modules/**

# Test files
test/**
tests/**
**/*.test.ts
**/*.spec.ts

# Documentation (except README and CHANGELOG)
docs/**
*.md
!README.md
!CHANGELOG.md

# Git files
.git/**
.gitattributes
.gitmodules

# CI/CD
.github/**
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml

# IDE files
.idea/**
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/**

# Temporary files
tmp/**
temp/**
*.tmp

# Coverage reports
coverage/**
.nyc_output/**

# Build scripts
scripts/**
webpack.config.js
rollup.config.js

# Misc
.env
.env.*
*.vsix
